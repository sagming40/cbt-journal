# === 비밀값: 절대 커밋하지 않는다 (CLAUDE.md "업로드 금지") ===
# 금고 열쇠는 각 PC 서랍에만 둔다. 저장소에는 "열쇠 모양"(.env.example)만 올린다
.env
.env.*
!.env.example

# === Node / 프론트(web/) ===
node_modules/
web/.svelte-kit/
web/build/

# === Go ===

# go build 결과 실행 파일, air(Hot Reload)가 쓰는 임시 폴더
/bin/
/tmp/
*.exe

# 프론트 빌드 결과를 embed용으로 복사해두는 곳 (ARCHITECTURE 7절)
# .gitkeep만 커밋해서, 프론트를 빌드하지 않은 PC · CI에서도 go build가 되게 한다
/internal/webdist/dist/*
!/internal/webdist/dist/.gitkeep


# === 에디터 / OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db

# === 로그 · 테스트 결과 ===
*.log
coverage/
