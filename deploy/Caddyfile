# 운영 서버 Caddy 설정 (ARCHITECTURE 7.2절)
# server의 /etc/caddy/Caddyfile로 copy하여 사용한다
# 비유 ─ 건물 1층 안내데스크: 외부 손님(443)을 맞아 신분증(인증서)을 보여 주고, 안쪽 사무실(127.0.0.1:8080)로 안내한다
# - 인증서 등록 이메일은 넣지 않는다: Let's Encrypt가 만료 알림 메일을 없앴고, 갱신은 Caddy가 알아서 한다 (7.2절)
# - 접근 로그(log)는 켜지 않는다: app log로 충분하고, 기록이 남는 곳을 늘리지 않는다 (REQUIREMENTS 5.1절)
# - 이 이름(cbt.sagming.com)만 받는다. IP로 들어오면 인증서가 없어 연결되지 않는다 ─ app이 보이지 않는다

cbt.sagming.com {
	# 보내는 글자 · 파일을 압축한다 (화면 첫 로딩이 가벼워진다)
	encode zstd gzip

	header {
		# HSTS: "이 주소는 앞으로 무조건 https로만 와라" ─ browser가 기억한다
		# 처음엔 하루(86400초)만 ─ 설정이 틀린 채로 길게 걸면 되돌리기 어렵다 → 확인 뒤 1년(31536000)으로 늘린다 (7.2절)
		Strict-Transport-Security "max-age=86400"
		# file 종류를 browser가 멋대로 짐작하지 못하게 한다 (글자 file이 script로 실행되는 공격 방지)
		X-Content-Type-Options "nosniff"
		# 다른 사이트가 우리 화면을 몰래 액자(iframe)에 넣어 click을 훔치지 못하게 한다
		X-Frame-Options "DENY"
		# 다른 site로 넘어갈 때 우리 주소의 경로(/records/…)까지는 알려주지 않는다
		Referrer-Policy "strict-origin-when-cross-origin"
		# 응답에 "Server: Caddy"를 제외시켜 무슨 program인지 굳이 알리지 않는다
		-Server
	}

	# app으로 넘긴다 ─ Caddy는 외부에서 온 X-Forwarded-For를 버리고 실제 접속 IP를 새로 붙인다
	# → app의 TRUSTED_PROXIES=127.0.0.1 규칙으로 진짜 IP가 나온다 (ARCHITECTURE 3.3절)
	reverse_proxy 127.0.0.1:8080
}
