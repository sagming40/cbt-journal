# server의 /etc/cbt/cbt.env로 복사하여 사용한다 (권한 640, 소유 root:cbt) ─ systemd가 app을 띄울 때 읽는다 (ARCHITECTURE 7.2절)
# <…> 자리는 /srv/cbt/.env에 만든 비밀번호와 동일한 값으로 바꾼다 ─ 저장소에는 빈칸만 올린다
# systemd가 읽는 형식이라 값에 따옴표를 쓰지 않는다
APP_ENV=production
# app은 server 안(127.0.0.1)에서만 연다 ─ 바깥 요청은 Caddy에서 받아넘긴다
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
# 혼자 쓰는 동안은 가입을 막는다 ─ 내 계정은 cbtctl user create로 만든다 (REQUIREMENTS A2)
ALLOW_SIGNUP=false
# Caddy(같은 server)가 붙인 X-Forwarded-For만 믿는다 → 실제 접속 IP로 요청 제한이 걸린다 (ARCHITECTURE 3.3절)
TRUSTED_PROXIES=127.0.0.1
DATABASE_URL=postgres://cbt:<POSTGRES_PASSWORD>@127.0.0.1:5432/cbt_journal?sslmode=disable
VALKEY_URL=redis://:<VALKEY_PASSWORD>@127.0.0.1:6379/0
