# CBT 저널 앱 서비스 (ARCHITECTURE 7.2절)
# 서버의 /etc/systemd/system/cbt.service로 복사해 쓴다.
# 비유: 관리인에게 주는 업무 지시서 ─ "이 계정으로, 이 설정을 읽고, 이 명령을 띄워. 쓰러지면 5초 뒤 다시 일으켜."

[Unit]
Description=CBT 저널 앱 (app serve)
# 네트워크와 Docker(Postgres · Valkey)가 뜬 다음에 시작한다.
After=network-online.target docker.service
Wants=network-online.target docker.service
# 재부팅 직후엔 DB가 아직 안 떠서 앱이 몇 번 실패할 수 있다 (7.5절).
# 2분 안에 20번까지는 다시 시도하고, 그보다 많이 실패하면 진짜 고장이라 보고 멈춘다(무한 반복 방지).
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=simple
# 로그인 불가 전용 계정으로 실행한다 ─ 앱이 털려도 root 권한은 없다.
User=cbt
Group=cbt
# 비밀값 · 설정 (root:cbt 640). 여기 적힌 KEY=값이 앱의 환경변수가 된다.
EnvironmentFile=/etc/cbt/cbt.env
# current는 지금 버전을 가리키는 링크다. 배포는 링크만 바꾸고 재시작한다 (7.3절).
ExecStart=/opt/cbt/current/app serve
# 앱이 어떤 이유로 끝나도 5초 뒤 다시 띄운다 (재부팅 직후 DB 대기 포함).
Restart=always
RestartSec=5
# 종료 신호(SIGTERM)를 받으면 앱이 처리 중인 요청을 10초까지 마무리한다(serve.go) → 넉넉히 15초 기다린다.
TimeoutStopSec=15

# ── 보호 옵션: 앱이 털려도 피해를 앱 안에 가둔다 ──
# 비유: 손님을 회의실 하나에만 들여보내고, 다른 방 문은 잠그고, 열쇠 복사기는 치우는 것.
# 권한을 더 얻는 것 금지 (setuid 프로그램 등).
NoNewPrivileges=yes
# 시스템 전체를 읽기 전용으로. 앱은 파일을 쓰지 않는다(로그는 화면 출력 → journald).
ProtectSystem=strict
# /home · /root를 안 보이게.
ProtectHome=yes
# 이 서비스만 쓰는 빈 /tmp.
PrivateTmp=yes
# 커널 설정 · 모듈 · cgroup을 건드리지 못하게.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# 특별 권한(capability)을 하나도 주지 않는다. 8080은 1024 위 포트라 필요 없다.
CapabilityBoundingSet=
# 인터넷(IPv4 · IPv6) · 같은 서버 안 통신만. 그 밖의 네트워크 종류는 금지.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
