# 이 파일을 복사해 .env를 만든다. .env는 커밋하지 않는다 (.gitignore).
# 로컬 개발용 값만 적는다. 운영 비밀번호는 절대 여기 쓰지 않는다.
# 앱 설정(DATABASE_URL 등)은 internal/config를 만드는 단계에서 추가한다.
POSTGRES_USER=cbt
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=cbt_journal


# --- 앱 설정 (internal/config) ---
# development 또는 production
APP_ENV=development
# 위 POSTGRES_* 값과 맞춘다. 포트는 compose의 5436 (5432는 직접 설치한 Postgres라 엉뚱한 DB에 붙는다)
DATABASE_URL=postgres://cbt:change-me-local@localhost:5436/cbt_journal?sslmode=disable
VALKEY_URL=redis://localhost:6380/0
# 선택 (비우면 기본값): HTTP_ADDR=127.0.0.1:8080, LOG_LEVEL=info
